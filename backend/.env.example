# ==========================================
# KARVAAN POS - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to '.env' and modify as needed.

# ------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------
# For Local POS: Leave as sqlite
# For Cloud VPS: Change to your postgres connection string and update schema.prisma to "postgresql"
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/karvaan_pos?schema=public"

# ------------------------------------------
# 2. GLOBAL SECURITY
# ------------------------------------------
# The secret key to secure your sync endpoints (MUST match exactly on Local and Cloud)
CLOUD_SYNC_API_KEY="my_super_secret_key_123"

# ------------------------------------------
# 3. CLOUD VPS SPECIFIC SETTINGS (Hostinger)
# ------------------------------------------
# Set to "true" ONLY on the Hostinger Cloud Server. 
# This prevents the cloud from running local background sync jobs.
IS_CLOUD="false"

# ------------------------------------------
# 4. LOCAL POS SPECIFIC SETTINGS (Restaurant PC)
# ------------------------------------------
# The URL of your Hostinger Cloud VPS (Leave empty on the Cloud VPS itself)
VPS_SYNC_URL="https://api.karvaan-cloud.com/sync"

# The unique ID of this specific restaurant.
# You only need to set this on the Local POS computers. Hostinger ignores this.
RESTAURANT_ID="c4f970bb-3469-4910-92b4-8ce831fdddcf"

# ------------------------------------------
# 5. SERVER CONFIGURATION
# ------------------------------------------
PORT=3001
JWT_SECRET="karvaan-pos-jwt-secret"
