# Prisma CLI uses this schema-relative URL. Local runtime uses AppData/KarvaanPOS/dev.db.
DATABASE_URL=file:./dev.db
PORT=3001
IS_CLOUD=false
# Local installations generate a private signing secret if empty.
# Cloud installations must provide a long randomly generated secret.
JWT_SECRET=
RESTAURANT_ID=
VPS_SYNC_URL=
CLOUD_SYNC_API_KEY=
# Receiver example: {"restaurant-id":"private-random-key"}
CLOUD_SYNC_KEYS={}
CLOUDINARY_URL=
