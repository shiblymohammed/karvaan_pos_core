{
  "name": "karvaan-pos-backend",
  "version": "1.0.0",
  "description": "Enterprise NestJS + Prisma + PostgreSQL backend for Karvaan POS Core Edition",
  "author": "Karvaan POS Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts",
    "start:prod": "node dist/src/main.js",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.3",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/socket.io": "^3.0.2",
    "fake-indexeddb": "6.2.5",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
