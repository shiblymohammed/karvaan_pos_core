// Karvaan POS Core Edition - Enterprise Database Schema
// Optimized for NestJS + Prisma ORM + PostgreSQL / SQLite fallback

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // For production cloud deployment, change provider to "postgresql" and set DATABASE_URL
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  pin       String   @unique // 4-digit PIN for rapid cashier/waiter terminal login
  role      String   @default("CASHIER") // ADMIN, MANAGER, CASHIER, WAITER, KITCHEN_STAFF
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated Order[] @relation("WaiterOrders")
  billsSettled  Bill[]  @relation("CashierBills")
}

model Table {
  id             String   @id @default(uuid())
  tableNumber    String   @unique
  capacity       Int      @default(4)
  status         String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, BILLED
  currentOrderId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float
  gstRate         Float    @default(5.0) // Percentage (e.g., 5.0 for 5% GST)
  categoryId      String
  isAvailable     Boolean  @default(true)
  prepTimeMinutes Int      @default(12) // SLA benchmark for KDS Green/Orange/Red timers
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  mobile        String   @unique
  totalSpend    Float    @default(0.0)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Order {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  tableId     String?
  waiterId    String?
  customerId  String?
  status      String   @default("RECEIVED") // RECEIVED, COOKING, READY, SERVED, CANCELLED
  totalAmount Float    @default(0.0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  table    Table?      @relation(fields: [tableId], references: [id])
  waiter   User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  bill     Bill?
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  price     Float
  notes     String? // e.g. "Less spicy", "No onions"
  status    String   @default("RECEIVED") // RECEIVED, COOKING, READY, SERVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Bill {
  id            String   @id @default(uuid())
  billNumber    String   @unique
  orderId       String   @unique
  subtotal      Float
  cgst          Float    @default(0.0)
  sgst          Float    @default(0.0)
  discount      Float    @default(0.0)
  grandTotal    Float
  paymentMethod String   @default("CASH") // CASH, CARD, UPI, SPLIT
  cashierId     String?
  settledAt     DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  cashier User? @relation("CashierBills", fields: [cashierId], references: [id])
}

model InventoryItem {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String // e.g. "Vegetables", "Dairy", "Meat", "Dry Pantry"
  currentStock Float    @default(0.0)
  unit         String   @default("kg") // kg, liters, pcs, packs
  minThreshold Float    @default(5.0)
  costPrice    Float    @default(0.0)
  updatedAt    DateTime @updatedAt

  logs StockLog[]
}

model StockLog {
  id             String   @id @default(uuid())
  itemId         String
  type           String // "IN", "OUT", "ADJUSTMENT"
  quantityChange Float
  notes          String?
  createdAt      DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
