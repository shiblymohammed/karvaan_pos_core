// Karvaan POS Core Edition - Enterprise Database Schema (Multi-Tenant)
// Optimized for NestJS + Prisma ORM + SQLite (production-ready, multi-year reliable)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite: zero-setup, single file, ideal for local restaurant PC deployment
  // To migrate to PostgreSQL, change provider to "postgresql" and set DATABASE_URL
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------------------------------------------------------
// TENANT MANAGEMENT
// ---------------------------------------------------------

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription Details
  subscriptionPlan   String   @default("TRIAL") // TRIAL, MONTHLY, YEARLY, CUSTOM
  subscriptionPrice  Float    @default(0)
  subscriptionExpiry DateTime?
  subscriptionStatus String   @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED

  // The owner of this restaurant (Role: OWNER)
  ownerId String
  owner   User   @relation("OwnerRestaurants", fields: [ownerId], references: [id])

  // Operational Data belonging to this Restaurant
  users          User[]          @relation("RestaurantUsers")
  tables         Table[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  orders         Order[]
  bills          Bill[]
  deliveryOrders DeliveryOrder[]
  parkedOrders   ParkedOrder[]
  inventory      InventoryItem[]
  wasteLogs      WasteLog[]
  settings       SystemSetting[]
  backups        BackupLog[]
}

// ---------------------------------------------------------
// USER MANAGEMENT
// ---------------------------------------------------------

model User {
  id       String  @id @default(uuid())
  name     String
  username String? @unique
  password String?
  pin      String? // PIN is optional for super admins / owners, required for POS staff

  // Roles: SUPER_ADMIN, OWNER, REST_ADMIN, MANAGER, CASHIER, WAITER, KITCHEN, DELIVERY
  role        String   @default("CASHIER")
  phone       String?
  isActive    Boolean  @default(true)
  permissions String? // JSON: {"canVoid":true,"canDiscount":true}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant Relations
  restaurantId     String? // Null for SUPER_ADMIN and OWNER. Required for REST_ADMIN and STAFF
  restaurant       Restaurant?  @relation("RestaurantUsers", fields: [restaurantId], references: [id], onDelete: Cascade)
  ownedRestaurants Restaurant[] @relation("OwnerRestaurants")

  // POS Operation Relations
  ordersCreated  Order[]         @relation("WaiterOrders")
  billsSettled   Bill[]          @relation("CashierBills")
  deliveryOrders DeliveryOrder[] @relation("RiderOrders")
}

// ---------------------------------------------------------
// POS OPERATIONS
// ---------------------------------------------------------

model Table {
  id             String   @id @default(uuid())
  tableNumber    String
  capacity       Int      @default(4)
  status         String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, BILLED
  currentOrderId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, tableNumber])
}

model Category {
  id        String  @id @default(uuid())
  name      String
  sortOrder Int     @default(0)
  iconName  String?
  imageUrl  String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([restaurantId, name])
}

model Product {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float
  gstRate         Float    @default(5.0)
  categoryId      String
  isAvailable     Boolean  @default(true)
  prepTimeMinutes Int      @default(12)
  imageEmoji      String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category    @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  recipeItems  RecipeIngredient[]
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  mobile        String
  email         String?
  address       String?
  totalSpend    Float     @default(0.0)
  loyaltyPoints Int       @default(0)
  creditBalance Float     @default(0.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  syncedAt      DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders        Order[]
  ledgerEntries LedgerEntry[]

  @@unique([restaurantId, mobile])
}

model Order {
  id          String    @id @default(uuid())
  orderNumber String
  orderType   String    @default("DINE_IN") // DINE_IN, PARCEL, DELIVERY
  tableId     String?
  waiterId    String?
  customerId  String?
  status      String    @default("RECEIVED") // RECEIVED, COOKING, READY, SERVED, CANCELLED
  totalAmount Float     @default(0.0)
  discount    Float     @default(0.0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  syncedAt    DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  table    Table?      @relation(fields: [tableId], references: [id])
  waiter   User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  bill     Bill?

  @@unique([restaurantId, orderNumber])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  price     Float
  notes     String?
  addons    String? // JSON: [{name, price}]
  status    String   @default("NEW") // NEW, SENT, COOKING, READY, SERVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Bill {
  id            String    @id @default(uuid())
  billNumber    String
  orderId       String    @unique
  orderType     String    @default("DINE_IN")
  subtotal      Float
  cgst          Float     @default(0.0)
  sgst          Float     @default(0.0)
  discount      Float     @default(0.0)
  deliveryFee   Float     @default(0.0)
  grandTotal    Float
  paymentMethod String    @default("CASH") // CASH, CARD, UPI, CREDIT, SPLIT
  cashierId     String?
  customerName  String?
  customerPhone String?
  waiterName    String?
  settledAt     DateTime  @default(now())
  syncedAt      DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  order   Order @relation(fields: [orderId], references: [id])
  cashier User? @relation("CashierBills", fields: [cashierId], references: [id])

  @@unique([restaurantId, billNumber])
}

model DeliveryOrder {
  id              String    @id @default(uuid())
  orderNumber     String
  customerName    String
  customerPhone   String?
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  riderId         String?
  riderName       String?
  status          String    @default("RECEIVED") // RECEIVED, PREPARING, READY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentMethod   String    @default("CASH") // CASH, UPI, CARD
  paymentStatus   String    @default("PENDING") // PENDING, COLLECTED
  grandTotal      Float     @default(0.0)
  deliveryFee     Float     @default(0.0)
  collectedAmount Float?
  items           String // JSON string of order items
  notes           String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  syncedAt        DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  rider User? @relation("RiderOrders", fields: [riderId], references: [id])

  @@unique([restaurantId, orderNumber])
}

model ParkedOrder {
  id        String   @id @default(uuid())
  orderId   String   @unique // Client-side order ID from frontend
  data      String // Full JSON snapshot of cart state
  heldAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// INVENTORY & LEDGER
// ---------------------------------------------------------

model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  category     String // e.g. "Vegetables", "Dairy", "Meat", "Dry Pantry"
  currentStock Float    @default(0.0)
  unit         String   @default("kg")
  minThreshold Float    @default(5.0)
  costPrice    Float    @default(0.0)
  updatedAt    DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  logs        StockLog[]
  recipeItems RecipeIngredient[]

  @@unique([restaurantId, name])
}

model StockLog {
  id             String    @id @default(uuid())
  itemId         String
  type           String // "IN", "OUT", "ADJUSTMENT", "WASTE"
  quantityChange Float
  reason         String? // "SALE", "DAMAGE", "EXPIRY", "RETURN", "PURCHASE"
  orderId        String?
  notes          String?
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WasteLog {
  id         String   @id @default(uuid())
  itemName   String
  quantity   Float
  unit       String   @default("pcs")
  reason     String // "RETURN", "SPOILAGE", "EXPIRY", "DAMAGE"
  orderId    String?
  billNumber String?
  loggedBy   String?
  createdAt  DateTime @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id           String   @id @default(uuid())
  customerId   String
  customerName String
  amount       Float
  type         String   @default("CREDIT") // CREDIT, PAYMENT
  billNumber   String?
  notes        String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ReturnRecord {
  id           String   @id @default(uuid())
  billNumber   String
  orderType    String
  reason       String
  action       String // "RESTOCK", "WASTE"
  refundDest   String // "CASH", "UPI", "LEDGER"
  totalRefund  Float
  items        String // JSON string of returned items
  authorizedBy String?
  createdAt    DateTime @default(now())

  // Note: For multi-tenant, technically we should link this to restaurant, 
  // but let's add it to maintain isolation.
  restaurantId String?
}

model BackupLog {
  id        String   @id @default(uuid())
  filename  String
  sizeBytes Int?
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  error     String?
  createdAt DateTime @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id         String   @id @default(uuid()) // Can no longer be singleton globally
  settingKey String   @default("general") // e.g. "hardware", "general"
  data       String // JSON string of all settings
  updatedAt  DateTime @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, settingKey])
}

model RecipeIngredient {
  id              String   @id @default(uuid())
  productId       String
  inventoryItemId String
  quantity        Float    // the amount to deduct from stock
  unit            String   // the unit of measurement (must match InventoryItem)
  
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryItemId])
}

