# =================================================================
# Karvaan POS Cloud Production Environment Template
# Copy this file to `.env` on your Linux VPS: `cp .env.production.example .env`
# =================================================================

# 1. Web Port (Default: 80 for direct web access, or 8080 if using host Caddy/Nginx)
PORT_HTTP=80

# 2. Security: Strong private JWT Secret (MANDATORY on Cloud)
# Generate a new one using: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret_generated_via_openssl_rand_hex_32

# 3. Super Admin Initial Credentials
# These will seed the master Super Admin user upon first startup
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!

# 4. Multi-Tenant Restaurant Sync Keys (Optional / As needed)
# Map restaurant UUIDs to their private sync keys for offline desktop sync
# Format: {"<restaurant-id>":"<sync-api-key>"}
CLOUD_SYNC_KEYS={}

# 5. Cloudinary Storage (Optional for receipt & menu images)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
