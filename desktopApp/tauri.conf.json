{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KarvaanPOS",
  "version": "1.0.1",
  "identifier": "com.karvaan.pos",
  "build": {
    "beforeDevCommand": "npm run prisma:generate --prefix ../backend && npm run build --prefix ../backend && npm run dev --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run prisma:generate --prefix ../backend && npm run build --prefix ../backend && npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Karvaan POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "externalBin": [
      "bin/node"
    ],
    "resources": {
      "../backend/dist/": "backend/dist/",
      "../backend/node_modules/": "backend/node_modules/",
      "../backend/prisma/schema.prisma": "backend/prisma/schema.prisma",
      "../backend/prisma/dev.db": "backend/prisma/dev.db"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/shiblymohammed/karvaan_pos_core/releases/latest/download/latest.json"
      ]
    },
    "sql": {
      "preloadConnections": [
        "sqlite:karvaan.db"
      ]
    }
  }
}
